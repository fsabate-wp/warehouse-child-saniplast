/* ==========================================================
   FICHA DE PRODUCTO - SANIPLAST (APARCADO / NO SE CARGA)
   Estos estilos corresponden a la plantilla de producto custom
   que todavia no esta desarrollada. Se movieron aqui desde
   custom.css el 16/08/2026 para que el child theme solo
   toque header y footer. Renombrar a product-ficha.css y
   registrarlo en config/theme.yml cuando se retome.
   ========================================================== */

/* Precios */
.saniplast-product-price .product-price {
    font-size: 32px;
    font-weight: 700;
    color: #1a1a1a;
}

.saniplast-product-price .regular-price {
    font-size: 18px;
    color: #888888;
    text-decoration: line-through;
    margin-right: 12px;
}

.saniplast-product-price .discount {
    background: #ffe5e5;
    color: #d31c2b;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
}

.saniplast-product-price .installments {
    color: #28a745;
    font-size: 15px;
    font-weight: 600;
    margin-top: 4px;
}

.saniplast-product-price .transfer-price {
    color: #555555;
    font-size: 14px;
    margin-top: 2px;
}

/* Stock */
.saniplast-stock {
    color: #28a745;
    font-weight: 600;
    font-size: 14px;
    margin: 12px 0;
}

.saniplast-stock .fa {
    margin-right: 4px;
}

/* Input cantidad */
.saniplast-add-to-cart .product-quantity {
    margin-bottom: 12px;
}

.saniplast-add-to-cart .qty input {
    width: 60px;
    height: 42px;
    text-align: center;
    border: 1px solid #cccccc;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
}

.saniplast-min-qty {
    font-size: 13px;
    color: #666666;
}

/* Botones de compra */
.saniplast-buy-actions {
    margin-top: 8px;
}

.saniplast-buy-actions .btn-buy-now {
    background: #d31c2b;
    border-color: #d31c2b;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 6px;
    width: 100%;
    margin-bottom: 10px;
}

.saniplast-buy-actions .btn-buy-now:hover {
    background: #b01723;
    border-color: #b01723;
}

.saniplast-buy-actions .btn-consult {
    background: #25d366;
    border-color: #25d366;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 6px;
    width: 100%;
}

.saniplast-buy-actions .btn-consult:hover {
    background: #1da851;
    border-color: #1da851;
}

/* Cálculo de envío */
.saniplast-shipping-calc {
    border: 1px solid #e3e3e3;
    border-radius: 6px;
    padding: 16px;
    margin-top: 16px;
}

.saniplast-shipping-calc h4 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
}

.saniplast-shipping-calc .input-group {
    display: flex;
    gap: 8px;
}

.saniplast-shipping-calc input {
    flex: 1;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 8px 12px;
}

.saniplast-shipping-calc button {
    background: #004489;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
}

/* Beneficios */
.saniplast-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
}

.saniplast-benefit-item {
    flex: 1 1 30%;
    background: #f8f9fa;
    border-radius: 6px;
    padding: 12px;
    text-align: center;
    font-size: 13px;
}

.saniplast-benefit-item .fa {
    display: block;
    font-size: 20px;
    color: #004489;
    margin-bottom: 6px;
}

.saniplast-benefit-item strong {
    display: block;
    color: #333333;
}

.saniplast-benefit-item span {
    color: #666666;
}
